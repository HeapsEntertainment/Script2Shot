{
  "name": "script2shot",
  "version": "1.0.0",
  "description": "Screenplay to Shotlist Studio",
  "author": "Heaps Entertainment",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.heapsentertainment.script2shot",
    "productName": "Script2Shot",
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!.git/**/*",
      "!dist/**/*",
      "!screenshot-*.png"
    ],
    "fileAssociations": [
      {
        "ext": "s2s",
        "name": "Script2Shot Project",
        "description": "Script2Shot Project File",
        "icon": "s2sicon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "s2sicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}